# Supply your own approved credentials in the launching environment.
# This file is an example only; the CLI does not auto-load .env files.
PRODUCTHUNT_TOKEN=
REDDIT_ACCESS_TOKEN=
REDDIT_USER_AGENT=node:site-harness:0.1.0 (by /u/YOUR_REDDIT_USERNAME)
# Override on restricted executors or to isolate projects:
# SITE_HARNESS_HOME=/absolute/path/to/private/state
# API_ANYTHING_BROWSER=/absolute/path/to/chromium
